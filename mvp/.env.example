# Copiar como .env junto a docker-compose.yml (en el repo: mvp/.env.example -> mvp/.env).
# Nunca subir el .env al repositorio.

# Obligatorio. Generarlo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Clave de la base PostgreSQL del contenedor (cambiarla si la máquina queda expuesta).
POSTGRES_PASSWORD=improntia

# Docentes que se crean al arrancar si no existen (mail:clave, separados por coma).
# Opcional: también se pueden crear con scripts.seed_teacher.
SEED_TEACHERS=

# URL con la que el NAVEGADOR llega a la API, y origen del dashboard permitido por CORS.
# En una sola computadora quedan así; para usarlo desde otra máquina de la red, cambiar
# localhost por la IP de esta (y reconstruir: docker compose up --build -d).
PUBLIC_API_URL=http://localhost:8010
CORS_ORIGINS=http://localhost:5173
